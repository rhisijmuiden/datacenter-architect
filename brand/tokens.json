{
  "$schema": "Design tokens for Datacenter Architect. Used by the Godot UI theme and any web tooling.",
  "color": {
    "ui": {
      "panel":       { "value": "#111D2B", "alpha": 0.88, "note": "HUD panel background" },
      "panelSolid":  { "value": "#142334", "note": "Modal / tooltip background" },
      "panelHover":  { "value": "#1D3247", "note": "Hover and selected state" },
      "line":        { "value": "#96BEDC", "alpha": 0.18, "note": "Panel borders and dividers" },
      "ink":         { "value": "#EAF2F8", "note": "Primary text" },
      "inkDim":      { "value": "#93A9BC", "note": "Secondary text, labels" }
    },
    "brand": {
      "amber":       { "value": "#FFB23E", "note": "Brand accent; also the colour of power" }
    },
    "system": {
      "power":       { "value": "#FFB23E" },
      "cooling":     { "value": "#55D2F2" },
      "fiber":       { "value": "#FF7A2F" },
      "network":     { "value": "#FFC533", "note": "Fiber cable trays inside halls" }
    },
    "state": {
      "ok":          { "value": "#5FD49B" },
      "warning":     { "value": "#FFB23E" },
      "critical":    { "value": "#FF6B5E" }
    },
    "world": {
      "grass":       { "value": "#6A9A4C" },
      "plotGrass":   { "value": "#78A855" },
      "asphalt":     { "value": "#4A4F57" },
      "concrete":    { "value": "#A9ADB1" },
      "wall":        { "value": "#C9D0D6" },
      "hallFloor":   { "value": "#9AA5AE" },
      "rack":        { "value": "#23282F" },
      "sky":         { "value": "#9FD0F0" }
    }
  },
  "font": {
    "display": { "family": "Barlow Condensed", "weights": [500, 600, 700], "license": "SIL Open Font License" },
    "body":    { "family": "Barlow", "weights": [400, 500, 600], "license": "SIL Open Font License" }
  },
  "radius": { "panel": 10, "button": 8, "chip": 4 },
  "spacing": { "xs": 4, "sm": 8, "md": 12, "lg": 16, "xl": 24 }
}
