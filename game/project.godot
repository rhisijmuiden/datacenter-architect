; Engine configuration file.
; Version and channel are stamped by the release workflow.

config_version=5

[application]

config/name="Datacenter Architect"
config/description="Build and run your own datacenter."
config/version="0.2.0"
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.5", "C#", "Forward Plus")
config/icon="res://icon.svg"
config/windows_native_icon=""
boot_splash/bg_color=Color(0.0667, 0.1137, 0.1686, 1)
boot_splash/show_image=false
config/use_custom_user_dir=true
config/custom_user_dir_name="Datacenter Architect"

[datacenter]

build/channel="dev"
updates/repository="rhisijmuiden/datacenter-architect"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/size/mode=2
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[dotnet]

project/assembly_name="DatacenterArchitect"

[input]

cam_rotate_left={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":81,"key_label":0,"unicode":113,"location":0,"echo":false,"script":null)]
}
cam_rotate_right={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":69,"key_label":0,"unicode":101,"location":0,"echo":false,"script":null)]
}

[internationalization]

locale/fallback="en"

[rendering]

lights_and_shadows/directional_shadow/size=8192
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
lights_and_shadows/directional_shadow/16_bits=false
anti_aliasing/quality/use_taa=false
environment/ssil/quality=2

anti_aliasing/quality/msaa_3d=2
environment/defaults/default_clear_color=Color(0.659, 0.839, 0.949, 1)
